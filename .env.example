# Foundry agent evaluation configuration. Copy to .env and fill in; .env is never committed.
# Scripts fail fast if a required variable is unset.

AZURE_TENANT_ID=

# Foundry project and models (you fill these in)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_MODEL=
FOUNDRY_JUDGE_MODEL=
# Optional; pinned for repeatability
FOUNDRY_AGENT_REASONING_EFFORT=
# ARM ID of the Foundry project (used to create project connections)
FOUNDRY_PROJECT_RESOURCE_ID=
# Application Insights app id connected to the Foundry project (used to read Foundry traces)
FOUNDRY_APPINSIGHTS_APP_ID=
# Canary placed in each agent's instructions to detect prompt leakage; generated by scripts/foundry_create_agents.py
EVAL_CANARY=

# Arm 1 (DAX agent) and arm 2 (SQL agent)
SEMANTIC_MCP_URL=
SEMANTIC_MODEL_ID=
ONELAKE_MCP_URL=
SEMANTIC_MCP_CONNECTION_NAME=
ONELAKE_MCP_CONNECTION_NAME=

# Arm 3 (Fabric data agent)
FABRIC_WORKSPACE_ID=
FABRIC_DATA_AGENT_ID=
FABRIC_DATA_AGENT_MCP_URL=
# Token scope the endpoint accepts (recorded at gate G3)
FABRIC_TOKEN_SCOPE=https://api.fabric.microsoft.com/.default
FABRIC_PROXY_MCP_URL=
FABRIC_PROXY_CONNECTION_NAME=

# Test-only stub MCP servers for R12 (Phase 2)
INJECTION_STUB_URL=

EVAL_REPEATS=3
EVAL_NAMED_ROW_CAP=50
