# The application reads environment variables; this file is a reference only.
# Every setting uses the WEALTH_MCP_ prefix.

# --- Which data path to use -------------------------------------------------
# offline     = catalog resources only, no network calls, no tools
# fabric_rest = live reads via the Power BI Execute Queries REST API
# remote_mcp  = Microsoft's preview MCP endpoint (returns 403 in this tenant)
WEALTH_MCP_BACKEND=offline

# --- Which semantic model to connect to -------------------------------------
# Required for any backend other than offline. Copy this file to .env (git-ignored)
# and fill in your own values; identifiers are never committed to this repository.
# They must also match the binding baked into the catalog, or startup fails.
# WEALTH_MCP_TENANT_ID=<entra-tenant-id>
# WEALTH_MCP_WORKSPACE_ID=<fabric-workspace-id>
# WEALTH_MCP_SEMANTIC_MODEL_ID=<semantic-model-id>
# WEALTH_MCP_REPORT_ID=<report-id>
# Used by the helper scripts under ../scripts.
# WEALTH_MCP_URL=https://<your-app>.azurewebsites.net/mcp

# --- How to authenticate to Fabric ------------------------------------------
# azure_cli        = local development, uses your signed-in az session
# managed_identity = App Service / Container Apps; needs ALLOW_APPLICATION_IDENTITY
# WEALTH_MCP_CREDENTIAL_MODE=azure_cli
# WEALTH_MCP_MANAGED_IDENTITY_CLIENT_ID=<user-assigned-identity-client-id>
# WEALTH_MCP_ALLOW_APPLICATION_IDENTITY=true

# --- Explicit POC approvals (all default to false) --------------------------
# WEALTH_MCP_ALLOW_UNVERIFIED_LIVE_DEFINITION=true
# WEALTH_MCP_ALLOW_AUTHOR_CATALOG=true
# WEALTH_MCP_ENABLE_GENERATE_QUERY=false

# --- Operator-only effectiveUsername permission probe -----------------------
# Disabled by default. Requires fabric_rest + execute_dax_queries, a workspace-admin
# backend identity, restricted inbound access, and an explicit JSON allowlist of test UPNs.
# WEALTH_MCP_DAX_ENDPOINT=execute_dax_queries
# WEALTH_MCP_ENABLE_EFFECTIVE_USERNAME_TEST=true
# WEALTH_MCP_EFFECTIVE_USERNAME_ALLOWLIST=["read-only-user@contoso.com","build-user@contoso.com"]

# --- Transport --------------------------------------------------------------
WEALTH_MCP_CATALOG_PATH=../artifacts/wealth-management-catalog.json
WEALTH_MCP_HOST=127.0.0.1
WEALTH_MCP_PORT=8000
# Binding off loopback additionally requires an explicit host allowlist.
# WEALTH_MCP_RESTRICTED_NETWORK_CONFIRMED=true
# WEALTH_MCP_ALLOWED_HOSTS=["<your-app>.azurewebsites.net"]
# WEALTH_MCP_ALLOWED_ORIGINS=["https://<your-app>.azurewebsites.net"]

# --- Only for remote_mcp ----------------------------------------------------
# WEALTH_MCP_CONTRACT_PATH=<reviewed-discovery-manifest.json>