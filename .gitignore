# Local source data and private metadata are not public source artifacts.
*.pbix
*.pbit
*.abf
**/.pbi/localSettings.json
**/.pbi/cache.abf
artifacts/
.tools/
.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
bin/
obj/
TestResults/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
