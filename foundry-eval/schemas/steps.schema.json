      "title": "Server Reported S"
    },
    "text_chars": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Chars"
    },
    "summary_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reasoning summary, when the platform returns one",
      "title": "Summary Text"
    }
  },
  "required": [
    "step_id",
    "attempt_id",
    "run_id",
    "arm",
    "index",
    "kind"
  ],
  "title": "StepRecord",
  "type": "object"
}
